set default:
    node 0:
    "Red" [color=red]
    "Blue" [color=blue]
    "Magenta" [color=magenta]
    "Black" [color=black]
    "White" [color=white]
    "Cool, that's all the colors I wanted to test."
    goto node:1

    node 1:
    "Wait I forgot one thing."
